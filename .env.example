# Template del file .env locale. Valori reali mai versionati.
#
# Valori che il kiosk usa per raggiungere il broker di campo: all'avvio
# diventano i default del broker. Quanto salvato da "Impostazioni -> broker"
# nel persist del browser ha la precedenza su questi valori.
#
# Se almeno una di queste e' impostata l'app parte con demoMode spento.
#
# I nomi non hanno prefisso VITE_, ma arrivano lo stesso al browser perche'
# "MQTT_" e' elencato in envPrefix dentro vite.config.ts: la password del
# broker finisce quindi nel bundle (il client MQTT gira nel browser).

# Endpoint broker MQTT (default in src/config/app.config.ts)
MQTT_HOST=
MQTT_PORT=9001
MQTT_PROTOCOL=ws
MQTT_PATH=/mqtt
MQTT_BASE_TOPIC=

# Prefissi di Home Assistant MQTT Discovery, separati da virgola
# (default: homeassistant). Esempio: homeassistant,zigbee2mqtt
MQTT_DISCOVERY_PREFIXES=

# Credenziali broker (segrete: solo ambiente dev, mai nel bundle)
MQTT_USERNAME=
MQTT_PASSWORD=
