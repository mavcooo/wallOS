[TEMPLATE]
# Template del file .env locale. Valori reali mai versionati.
#
# Due blocchi distinti:
#  - MQTT_* arriva al browser (envPrefix in vite.config.ts): credenziali del
#    broker usate dal client WebSocket del kiosk;
#  - AUTH_*/JWT_*/ADMIN_*/KIOSK_* resta sul server Node: qui vivono JWT secret,
#    password e PIN. Nessuno di questi nomi ha prefisso VITE_, quindi Vite non
#    li include nel bundle.

# ── Broker MQTT (visibile al browser) ────────────────────────────────────────
# Endpoint broker: all'avvio diventano i default del pannello; quanto salvato
# da "Impostazioni -> broker" nel persist locale ha la precedenza.
# Se almeno una di queste è impostata l'app parte con demoMode spento.
MQTT_HOST=
MQTT_PORT=9001
MQTT_PROTOCOL=ws
MQTT_PATH=/mqtt
MQTT_BASE_TOPIC=

# Prefissi Home Assistant MQTT Discovery, separati da virgola.
MQTT_DISCOVERY_PREFIXES=

# Credenziali broker (finiscono nel bundle: utenza dedicata con ACL topic).
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Micro-servizio auth (solo server) ────────────────────────────────────────
# `npm run dev:auth` ascolta qui; il dev server Vite proxa /api su questo target.
AUTH_HOST=127.0.0.1
AUTH_PORT=8787
AUTH_DB_PATH=./data/auth.sqlite
AUTH_PROXY_TARGET=http://127.0.0.1:8787
# true solo dietro reverse proxy fidato (X-Forwarded-For), altrimenti è spoofabile.
AUTH_TRUST_PROXY=false

# Origini autorizzate per CORS e controllo CSRF. In LAN aggiungi l'IP del tablet.
CORS_ORIGINS=http://localhost:3000

# Segreto di firma JWT: >= 32 caratteri, obbligatorio in produzione.
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
KIOSK_REFRESH_TOKEN_TTL=7776000
ELEVATION_TTL=300
SWITCH_PROFILE_TTL=600

# Cookie Secure: true in produzione (richiede HTTPS), false solo in LAN chiusa.
COOKIE_SECURE=false
BCRYPT_ROUNDS=10

# Seed iniziale: applicato SOLO al primo avvio, se il profilo non esiste.
# In produzione ADMIN_PASSWORD e ADMIN_PIN sono obbligatorie e senza default.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Amministratore
ADMIN_PASSWORD=
ADMIN_PIN=2468

KIOSK_USERNAME=kiosk
KIOSK_DISPLAY_NAME=Pannello Parete
KIOSK_DEVICE_ID=wall-panel-1
KIOSK_PIN=1234

# Rate limiting server-side.
PIN_MAX_ATTEMPTS=3
PIN_LOCKOUT_MS=60000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MS=300000

# ── Configurazione client (visibile al browser, nessun segreto) ──────────────
# Base delle API auth: `/api` viene proxata al server in dev/preview.
VITE_AUTH_API_BASE=/api
# Identificativo del tablet a parete (deve combaciare con kiosk_device_id nel DB).
VITE_KIOSK_DEVICE_ID=wall-panel-1
