[TEMPLATE]
# Template del file .env locale. Valori reali mai versionati.
#
# Due superfici distinte:
#  - VITE_* arriva al browser: solo configurazione PUBBLICA (endpoint API,
#    host/porta/path del broker, prefissi discovery). Vite non espone altro e
#    il build fallisce se un nome VITE_* contiene PASSWORD/SECRET/TOKEN/KEY
#    (vite.config.ts + tools/verify-build-secrets.mjs);
#  - MQTT_*/MOSQUITTO_*/AUTH_*/JWT_*/ADMIN_*/KIOSK_*/DB_* restano sul server
#    Node o in Docker Compose: credenziali broker, JWT secret, password e PIN
#    non entrano mai nel bundle.
#
# Le credenziali del pannello NON si mettono nel .env: si inseriscono una
# volta sul dispositivo in Impostazioni -> broker (vedi sotto).

# ── Broker MQTT · configurazione PUBBLICA del pannello (build Vite) ──────────
# All'avvio questi valori diventano i default del pannello; quanto salvato da
# "Impostazioni -> broker" nel persist locale ha la precedenza.
# Se almeno uno è impostato l'app parte con demoMode spento.
# L'host, se assente, è quello da cui il browser ha caricato la dashboard.
VITE_MQTT_HOST=
VITE_MQTT_PORT=9001
VITE_MQTT_PROTOCOL=ws
VITE_MQTT_PATH=/mqtt
VITE_MQTT_BASE_TOPIC=

# Prefissi Home Assistant MQTT Discovery, separati da virgola.
VITE_MQTT_DISCOVERY_PREFIXES=

# Credenziali del PANNELLO: MAI nel bundle e MAI in questo file.
# Sul pannello apri Impostazioni -> broker e inserisci l'utenza dedicata
# `wallos_kiosk` (sola lettura degli stati, scrittura solo sui topic di
# comando). La password si genera con tools/init-mqtt-auth.sh
# (MOSQUITTO_KIOSK_PASSWORD) e resta sul dispositivo nel persist locale.
# Non usare mai l'utenza `wallos_backend`: ha readwrite #.

# ── Credenziali broker del SERVER (solo Node, MAI nel bundle) ────────────────
# Utenza `wallos_backend` (readwrite #) per eventi topologia, automazioni e
# ingestion. In Docker Compose arrivano da MOSQUITTO_BACKEND_*, non da qui.
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Broker Mosquitto (solo Docker Compose, MAI nel bundle) ───────────────────
# Niente prefisso VITE_: Vite espone solo le VITE_* e un nome sensibile con
# quel prefisso blocca il build. `MOSQUITTO_KIOSK_PASSWORD` è la password che
# va poi inserita a runtime sul pannello, mai passata alla build.
# Interfaccia host su cui pubblicare 1883/9001: 127.0.0.1 = solo questa
# macchina; in LAN usa l'IP dell'interfaccia autorizzata (mai 0.0.0.0).
MOSQUITTO_BIND_IP=127.0.0.1
MOSQUITTO_BACKEND_USERNAME=wallos_backend
MOSQUITTO_BACKEND_PASSWORD=
MOSQUITTO_KIOSK_USERNAME=wallos_kiosk
MOSQUITTO_KIOSK_PASSWORD=
# Simulatore IoT: solo profilo `dev`, opzionale.
MOSQUITTO_SIM_PASSWORD=

# ── Eventi di topologia in tempo reale (solo server) ──────────────────────────
# Il server pubblica `wallos/system/topology_changed` dopo ogni CRUD su
# PostgreSQL, così tutti i tablet si riallineano senza reload.
# Endpoint TCP del broker (il browser usa il listener WebSocket qui sopra).
# Se MQTT_HOST è assente e MQTT_SERVER_URL non è impostata, la pubblicazione
# resta disabilitata e il server funziona comunque.
# MQTT_SERVER_URL=mqtt://192.168.0.10:1883
MQTT_SERVER_PORT=1883
# Prefisso topic del server: se non vuoto deve combaciare con
# VITE_MQTT_BASE_TOPIC del pannello e con mosquitto/config/acl.
MQTT_BASE_TOPIC=

# ── Ingestion telemetria (solo server) ──────────────────────────────────────
# Il worker ascolta i meter (Shelly/Tasmota/JSON custom) e scrive i campioni in
# `telemetry_history`, la sorgente dei grafici 24h/7d/30d di EnergyPage.
# Intervallo minimo fra due campioni dello stesso device+metrica, in ms
# (default 60000, validato fra 10000 e 900000): evita di saturare il database
# con un meter che pubblica ogni secondo.
# TELEMETRY_SAMPLE_INTERVAL_MS=60000
# Variazione relativa minima (0–1) fra due letture dello stesso device+metrica
# per salvare un campione (default 0.02 = 2%; 0 disattiva il filtro).
# TELEMETRY_SIGNIFICANT_DELTA_RATIO=0.02
# Una serie piatta viene comunque salvata ogni tanto, per non lasciare buchi
# nella finestra storica (default 900000 ms, validato fra 60000 e 86400000).
# TELEMETRY_HEARTBEAT_MS=900000
# Retention dei campioni grezzi: ogni quanto gira il job (default 1 h) e oltre
# quanti giorni cancellare (default 30, come `cleanup_telemetry_history()`).
# TELEMETRY_RETENTION_INTERVAL_MS=3600000
# TELEMETRY_RETENTION_DAYS=30

# ── Motore di automazioni (solo server) ──────────────────────────────────────
# Elenco, attivazione e test delle regole dal pannello (Admin -> Automazioni);
# il motore vive nel processo Node e continua a lavorare anche a pannello spento.
# Coordinate per alba/tramonto, in gradi decimali (est positiva).
# Senza entrambe le regole solari restano inerti e il pannello lo segnala.
AUTOMATION_LATITUDE=41.9028
AUTOMATION_LONGITUDE=12.4964
# Topic MQTT della presenza in casa (relativo a MQTT_BASE_TOPIC):
# on/true/1/home = casa occupata. Se assente, `user_present` non è mai
# soddisfatta e le regole che la richiedono non scattano.
AUTOMATION_PRESENCE_TOPIC=

# ── PostgreSQL (solo server) ────────────────────────────────────────────────
# Unico storage di credenziali, sessioni e topologia della casa.
# Host PostgreSQL della LAN che ospita il database "wallos".
DB_HOST=192.168.0.59
DB_PORT=5432
DB_NAME=wallos
DB_USER=wallos_user
DB_PASSWORD=your_secure_password

# URL completa: se presente ha la precedenza sulle variabili DB_* (che, quando
# la URL manca, sono tutte obbligatorie). Le credenziali nell'URL vanno
# percent-encoded (@ → %40, : → %3A, / → %2F); con caratteri alfanumerici
# DB_USER/DB_PASSWORD bastano. DATABASE_URL e DB_* devono concordare.
DATABASE_URL=postgres://wallos_user:your_secure_password@192.168.0.59:5432/wallos

# Pool: connessioni contemporanee, chiusura delle inattive, timeout di apertura.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_SSL=false

# ── Seed dei dati demo (solo server) ───────────────────────────────────────
# `true` = all'avvio inserisce la topologia demo (piani, stanze, dispositivi,
# scenari) e gli account admin/kiosk, ma SOLO se il database è vuoto: con dati
# già presenti il seed viene saltato e non sovrascrive nulla.
# Default `false`: in produzione il bootstrap non scrive mai dati mock.
# Per popolare un database di test/sviluppo usare la CLI:
#   npm run db:seed        # scrive solo se il database è vuoto
#   npm run db:seed:force  # TRUNCATE … CASCADE delle tabelle demo, poi reseed
AUTO_SEED=false

# ── Micro-servizio auth + topologia (solo server) ───────────────────────────
# `npm run dev:auth` ascolta qui; il dev server Vite proxa /api su questo target.
AUTH_HOST=127.0.0.1
AUTH_PORT=8787
AUTH_PROXY_TARGET=http://127.0.0.1:8787
# true solo dietro reverse proxy fidato (X-Forwarded-For), altrimenti è spoofabile.
AUTH_TRUST_PROXY=false

# Origini aggiuntive per CORS e controllo CSRF. Il pannello chiama la propria
# origine (Origin == Host), quindi l'IP della LAN non serve qui: elenca solo
# origini diverse (reverse proxy, dominio dedicato), separate da virgola.
CORS_ORIGINS=http://localhost:3000

# Segreto di firma JWT: >= 32 caratteri, obbligatorio in produzione.
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
KIOSK_REFRESH_TOKEN_TTL=7776000
ELEVATION_TTL=300
SWITCH_PROFILE_TTL=600

# Cookie Secure: true in produzione (richiede HTTPS), false solo in LAN chiusa.
COOKIE_SECURE=false
BCRYPT_ROUNDS=10

# Credenziali usate dal seed (CLI `db:seed` o `AUTO_SEED=true`): l'utente
# viene creato solo se non esiste già, mai sovrascritto.
# In produzione ADMIN_PASSWORD e ADMIN_PIN sono obbligatorie e senza default.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Amministratore
ADMIN_PASSWORD=
ADMIN_PIN=2468

KIOSK_USERNAME=kiosk
KIOSK_DISPLAY_NAME=Pannello Parete
KIOSK_DEVICE_ID=wall-panel-1
KIOSK_PIN=1234

# Rate limiting server-side.
PIN_MAX_ATTEMPTS=3
PIN_LOCKOUT_MS=60000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MS=300000

# ── Migration & Database Versioning ─────────────────────────────────────────
# Eseguire `npm run migrate:up` all'avvio per applicare le migrazioni pendenti.
# Migrazioni versionate in server/migrations/ con il runner di server/migrate.ts
# Usare DATABASE_URL o DB_* per la connessione.
# DATABASE_URL ha la precedenza sulle variabili DB_*.
# DATABASE_URL esempio: postgres://wallos_user:s3cret@192.168.0.59:5432/wallos

# ── Backup & Restore ────────────────────────────────────────────────────────
# Eseguire `npm run db:backup` per generare un dump compressato.
# Eseguire `npm run db:backup -- --restore <filepath>` per ripristinare.
# Nomenclatura file: wallos_backup_YYYY-MM-DD_HH-mm-ss.sql.gz
# Retention: mantiene gli ultimi $RETENTION_COUNT backup o ultim $RETENTION_COUNT giorni.
# Variabili opzionali:
#   BACKUP_DIR=./backups          # Directory di destinazione (default ./backups)
#   RETENTION_DAYS=7              # Mantieni gli ultimi N giorni di backup
#   RETENTION_COUNT=10            # Mantieni gli ultimi N file di backup

# ── Configurazione client (visibile al browser, nessun segreto) ──────────────
# Base delle API auth: `/api` viene proxata al server in dev/preview.
VITE_AUTH_API_BASE=/api
# Identificativo del tablet a parete (deve combaciare con kiosk_device_id nel DB).
VITE_KIOSK_DEVICE_ID=wall-panel-1
